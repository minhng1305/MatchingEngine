# Example/Template file for shared secrets
# Copy this file to secrets.properties and fill in your actual values
# DO NOT commit the actual secrets.properties file to version control

# Database password
spring.datasource.password=YOUR_DATABASE_PASSWORD_HERE

# JWT secret (generate a secure random 64-character hex string)
jwt_secret=YOUR_JWT_SECRET_HERE

# Redis password (if applicable, leave empty if not using password)
spring.data.redis.password=YOUR_REDIS_PASSWORD_HERE
